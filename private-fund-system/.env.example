# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=private_fund_dev
DB_USER=postgres
DB_PASS=postgres

# Wind API配置
WIND_API_KEY=your_wind_api_key
WIND_API_SECRET=your_wind_api_secret
WIND_REST_URL=https://api.wind.com.cn
WIND_WS_URL=wss://ws.wind.com.cn

# LLaMA模型配置
LLAMA_MODEL_PATH=./models/llama-2-7b-chat.Q4_K_M.gguf
LLAMA_CONTEXT_SIZE=4096
LLAMA_GPU_LAYERS=0

# JWT配置
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs
