{
  "name": "private-fund-system",
  "version": "1.0.0",
  "description": "私募基金管理系统 - 投前投后市场信息一体化平台",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "lint": "eslint src/",
    "test": "jest",
    "db:init": "node database/init.js",
    "db:migrate": "node database/migrate.js"
  },
  "keywords": ["private-fund", "investment", "wind-api", "llama"],
  "author": "Private Fund Team",
  "license": "MIT",
  "dependencies": {
    "electron": "^28.0.0",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "pg": "^8.11.3",
    "sequelize": "^6.35.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "axios": "^1.6.2",
    "ws": "^8.14.2",
    "node-llama-cpp": "^2.0.0",
    "chart.js": "^4.4.1",
    "vue": "^3.3.8",
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "element-plus": "^2.4.3",
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^5.4.3"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "@vue/compiler-sfc": "^3.3.8",
    "vite": "^5.0.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "sass": "^1.69.5",
    "typescript": "^5.3.2"
  },
  "build": {
    "appId": "com.privatefund.system",
    "productName": "私募基金管理系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
